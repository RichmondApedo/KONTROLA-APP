# Rename this file to .env and fill in your keys.

# Google AI Studio API Key for Genkit
# Get yours from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
# Mono API Keys for Account Linking
# Get these from your Mono dashboard: https://app.withmono.com/
MONO_PUBLIC_KEY="your_mono_public_key_here"
MONO_SECRET_KEY="your_mono_secret_key_here"

# Paystack API Keys for Subscriptions
# Get these from your Paystack dashboard: https://dashboard.paystack.com/#/settings/keys
PAYSTACK_PUBLIC_KEY="your_paystack_public_key_here"
PAYSTACK_SECRET_KEY="your_paystack_secret_key_here"

# Cron Job Secret for scheduled tasks
# Generate a long, random, and secret string.
CRON_SECRET="your_super_secret_and_random_string_here"

# Firebase Cloud Messaging
FIREBASE_VAPID_KEY="your_firebase_vapid_key_here"

# Firebase Service Account (as a single-line JSON string)
# Go to Firebase Console > Project Settings > Service accounts > Generate new private key
# Copy the entire JSON content and paste it here, removing newlines to make it a single line.
# Example: FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'
FIREBASE_SERVICE_ACCOUNT='your_firebase_service_account_json_here'

# Firebase App Check (reCAPTCHA v3 Site Key)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your_recaptcha_site_key_here"

# Firebase Client Configuration for App Check & Auth
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_firebase_project_id_here"
NEXT_PUBLIC_FIREBASE_APP_ID="your_firebase_app_id_here"
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key_here"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_firebase_auth_domain_here"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_firebase_messaging_sender_id_here"


rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      let adminPath = /databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid);
      return isSignedIn() && exists(adminPath) && get(adminPath).data.role == 'admin';
    }

    // Helper for Business Delegation
    function getGrant(ownerId) {
       let grantId = ownerId + "_" + request.auth.uid;
       return get(/databases/$(database)/documents/business_access_grants/$(grantId));
    }

    function isDelegate(ownerId, level) {
       let grantId = ownerId + "_" + request.auth.uid;
       let grantPath = /databases/$(database)/documents/business_access_grants/$(grantId);
       if (!isSignedIn() || !exists(grantPath)) return false;
       
       let grant = get(grantPath);
       return level == 'viewer' ? 
          (grant.data.accessLevel == 'viewer' || grant.data.accessLevel == 'editor') : 
          grant.data.accessLevel == 'editor';
    }

    function isBusinessCollection(col) {
      return col in ['expenses', 'incomeSources', 'customers', 'invoices', 'receipts', 'bills', 'budgets', 'savingsGoals', 'shoppingLists'];
    }

    function isSafeUpdate() {
      // GOOGLE EXPERT AUDIT: Use delta-tracking (diff) to prevent field-injection.
      // This ensures a user can ONLY update their own preferences, not system fields.
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return !affected.hasAny(['role', 'plan', 'uid', 'emailVerified']) || isAdmin();
    }

    function isInvitationRecipient(invData) {
      return isSignedIn() && request.auth.token.email_verified && 
             request.auth.token.email.lower() == invData.targetEmail.lower();
    }

    // --- ACCESS GRANTS (MANAGEMENT) ---
    match /business_invitations/{invId} {
      // Owner can read/write their own invites.
      // Recipient can read their invites and update the status.
      allow read: if isSignedIn() && (request.auth.uid == resource.data.ownerUid || isInvitationRecipient(resource.data));
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerUid;
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.ownerUid) || 
        (isInvitationRecipient(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'targetUid']))
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerUid;
    }

    match /business_access_grants/{grantId} {
      // A grant is OWNER_TARGET. Only the involved parties can read.
      allow read: if isSignedIn() && (request.auth.uid in grantId.split('_'));
      
      // CRITICAL: A user can only create a grant for THEMSELVES.
      // And only if the grantId matches the naming convention.
      allow create: if isSignedIn() && 
                     request.auth.uid == request.resource.data.targetUid &&
                     grantId == request.resource.data.ownerUid + "_" + request.auth.uid;
      
      // Only the owner can revoke (delete) a grant.
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.ownerUid || isAdmin());
    }

    // --- INFRASTRUCTURE (GOOGLE HARDENED) ---
    match /audit_logs/{id} {
      // Blind-write for all authenticated users; Read strictly for Admins.
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // --- SUPPORT SYSTEM ---
    match /supportTickets/{ticketId} {
      // Any signed in user can create a ticket
      allow create: if isSignedIn();
      // Only the ticket owner or an Admin can read the ticket
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      // Only Admins can update status or delete
      allow update, delete: if isAdmin();
    }

    // --- USERS BRANCH ---
    match /users/{userId} {
      // Base document read (Owner/Admin only)
      allow read: if isOwner(userId) || isAdmin();
      // Account registration/deletion (Owner/Admin only)
      allow create, delete: if isOwner(userId) || isAdmin();

      // Profile & Security - Hardened Integrity
      match /profile/{allPaths=**} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, delete: if isOwner(userId) || isAdmin();
        // Owners can update profile only via SafeUpdate (No role/plan tampering)
        allow update: if (isOwner(userId) && isSafeUpdate()) || isAdmin();
      }

      // Infrastructure: AI Usage tracking (READ-ONLY for users to prevent quota resets)
      match /aiUsage/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      // Infrastructure: Sensitive Personal Sensitive Data (Isolation)
      match /linkedAccounts/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Business & Personal Transactional Stack (Privacy Shield Enforced)
      match /{collectionName}/{docId} {
        // ENFORCED PRIVACY SHIELD: 
        // Delegates (Viewers/Editors) can ONLY access documents marked 'context: business'.
        
        allow read: if isOwner(userId) || isAdmin() || (
                       isBusinessCollection(collectionName) && 
                       isDelegate(userId, 'viewer') && 
                       resource.data.context == 'business'
                    );
        
        allow create: if isOwner(userId) || isAdmin() || (
                       isBusinessCollection(collectionName) && 
                       isDelegate(userId, 'editor') && 
                       request.resource.data.context == 'business'
                    );

        allow update: if isOwner(userId) || isAdmin() || (
                       isBusinessCollection(collectionName) && 
                       isDelegate(userId, 'editor') && 
                       resource.data.context == 'business' &&
                       request.resource.data.context == 'business'
                    );

        allow delete: if isOwner(userId) || isAdmin() || (
                       isBusinessCollection(collectionName) && 
                       isDelegate(userId, 'editor') && 
                       resource.data.context == 'business'
                    );
        
        // Default Owner Access for mixed-context collections
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Final Defensive Layer
      match /{allPaths=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
  }
}
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions (Standard CEL - Pure Expressions)
    // ------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin';
    }

    function isContextMixed(col) {
      return col in ['expenses', 'incomeSources', 'bills'];
    }

    function isBusinessOnly(col) {
      return col in ['customers', 'invoices', 'receipts', 'budgets', 'savingsGoals', 'shoppingLists', 'vendors'];
    }

    function hasBusinessAccess(ownerId) {
      return isSignedIn() && exists(/databases/$(database)/documents/business_access_grants/$(ownerId + "_" + request.auth.uid));
    }

    function getBusinessAccessLevel(ownerId) {
      return get(/databases/$(database)/documents/business_access_grants/$(ownerId + "_" + request.auth.uid)).data.accessLevel;
    }

    function isValidTransaction(data) {
      return data.amount is number && 
             data.amount > 0 &&
             data.category is string &&
             data.date is timestamp &&
             data.description is string;
    }

    // --- ACCESS GRANTS (MANAGEMENT) ---
    match /business_invitations/{invId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.ownerUid || 
        request.auth.token.email.lower() == resource.data.targetEmail.lower()
      );
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerUid;
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.ownerUid) || 
        (isInvitationRecipient(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'targetUid']))
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerUid;
    }

    match /business_access_grants/{grantId} {
      allow read: if isSignedIn() && (
        request.auth.uid in grantId.split('_') ||
        request.auth.token.email.lower() == resource.data.targetEmail.lower()
      );
      allow create: if isSignedIn() && 
                     request.auth.uid == request.resource.data.targetUid &&
                     grantId == request.resource.data.ownerUid + "_" + request.auth.uid;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerUid;
    }

    // --- INFRASTRUCTURE ---
    match /audit_logs/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if isAdmin();
    }

    // --- USERS BRANCH ---
    match /users/{userId} {
      allow read, create, delete: if isOwner(userId) || isAdmin();

      match /profile/{allPaths=**} {
        allow read, create, delete: if isOwner(userId) || isAdmin() || hasBusinessAccess(userId);
        allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan', 'uid', 'emailVerified', 'ownerUid', 'createdAt'])) || isAdmin();
      }

      match /aiUsage/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      match /linkedAccounts/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /notifications/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /{collectionName}/{docId} {
        allow read: if isOwner(userId) || 
                    isAdmin() || 
                    (isContextMixed(collectionName) && 
                     hasBusinessAccess(userId) && 
                     resource.data.context == 'business') ||
                    (isBusinessOnly(collectionName) && 
                     hasBusinessAccess(userId));
        
        allow create: if (isOwner(userId) || 
                        isAdmin() || 
                        (isContextMixed(collectionName) && 
                         hasBusinessAccess(userId) &&
                         getBusinessAccessLevel(userId) == 'editor' &&
                         request.resource.data.context == 'business' &&
                         (!('creatorId' in request.resource.data) || request.resource.data.creatorId == request.auth.uid)
                        ) ||
                        (isBusinessOnly(collectionName) && 
                         hasBusinessAccess(userId) &&
                         getBusinessAccessLevel(userId) == 'editor' &&
                         (!('creatorId' in request.resource.data) || request.resource.data.creatorId == request.auth.uid)
                        )) && isValidTransaction(request.resource.data);

        allow update: if (isOwner(userId) || 
                        isAdmin() || 
                        (isContextMixed(collectionName) && 
                         hasBusinessAccess(userId) &&
                         getBusinessAccessLevel(userId) == 'editor' &&
                         request.resource.data.context == 'business' &&
                         resource.data.context == 'business'
                        ) ||
                        (isBusinessOnly(collectionName) && 
                         hasBusinessAccess(userId) &&
                         getBusinessAccessLevel(userId) == 'editor'
                        )) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan', 'uid', 'emailVerified', 'ownerUid', 'createdAt'])) && isValidTransaction(request.resource.data);

        allow delete: if isOwner(userId) || 
                      isAdmin() || 
                      (isContextMixed(collectionName) && 
                       hasBusinessAccess(userId) &&
                       getBusinessAccessLevel(userId) == 'editor' &&
                       resource.data.context == 'business'
                      ) ||
                      (isBusinessOnly(collectionName) && 
                       hasBusinessAccess(userId) &&
                       getBusinessAccessLevel(userId) == 'editor');
      }

      match /{allPaths=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
  }
}
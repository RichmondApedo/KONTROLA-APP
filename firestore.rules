rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // New check for admin role from the profile
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin';
    }

    // Validation helpers
    function isNotBlank(val) {
      return val is string && val.trim().size() > 0;
    }

    // ------------------------------------------------------------------------
    // Flattened Rules (Direct Path Matching)
    // ------------------------------------------------------------------------

    // User Profile
    match /users/{userId}/profile/{docId} {
      allow read: if isOwner(userId) && docId == userId;
      allow create: if isOwner(userId) && docId == userId;
      allow update: if isOwner(userId) && docId == userId;
    }

    // Income Sources
    match /users/{userId}/incomeSources/{id} {
      allow read, list: if isOwner(userId);
      allow create, update, delete: if isOwner(userId);
    }

    // Expenses
    match /users/{userId}/expenses/{id} {
      allow read, list: if isOwner(userId);
      allow create, update, delete: if isOwner(userId);
    }

    // Budgets
    match /users/{userId}/budgets/{id} {
      allow read, list: if isOwner(userId);
      allow create, update, delete: if isOwner(userId);
    }

    // Savings Goals
    match /users/{userId}/savingsGoals/{id} {
      allow read, list: if isOwner(userId);
      allow create, update, delete: if isOwner(userId);
    }

    // Bills
    match /users/{userId}/bills/{id} {
      allow read, list: if isOwner(userId);
      allow create, update, delete: if isOwner(userId);
    }

    // AI Conversations (Memory)
    match /users/{userId}/chats/{chatType}/messages/{id} {
      allow read, list, create: if isOwner(userId);
    }
    
    // Explicit match for the chat document itself if queried
    match /users/{userId}/chats/{chatType} {
      allow get: if isOwner(userId);
    }

    // AI Advisor History
    match /users/{userId}/advisorHistory/{id} {
      allow read, list, create: if isOwner(userId);
    }

    // Linked Accounts
    match /users/{userId}/linkedAccounts/{id} {
      allow read, list: if isOwner(userId);
      allow create, update, delete: if isOwner(userId);
    }

    // Business Customers, Invoices, Receipts
    match /users/{userId}/customers/{id} { allow read, list, write: if isOwner(userId); }
    match /users/{userId}/invoices/{id} { allow read, list, write: if isOwner(userId); }
    match /users/{userId}/receipts/{id} { allow read, list, write: if isOwner(userId); }
    match /users/{userId}/shoppingLists/{id} { allow read, list, write: if isOwner(userId); }

    // Public Banners
    match /home_banners/{id} {
      allow read: if true;
    }

    // Audit Logs
    match /audit_logs/{id} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
  }
}
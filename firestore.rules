rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions (Standard CEL - Pure Expressions)
    // ------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBusinessCollection(col) {
      return col in ['expenses', 'incomeSources', 'customers', 'invoices', 'receipts', 'bills', 'budgets', 'savingsGoals', 'shoppingLists'];
    }

    // --- DATA INTEGRITY HELPERS ---

    function isValidAmount(data) {
      return !('amount' in data) || (data.amount is number && data.amount >= 0);
    }

    function isValidContext(data) {
      return !('context' in data) || (data.context in ['personal', 'business']);
    }

    function isValidTransaction(data) {
      return isValidAmount(data) && 
             isValidContext(data) &&
             (!('description' in data) || (data.description is string && data.description.size() > 0));
    }

    function isInvitationRecipient(invData) {
      return isSignedIn() && request.auth.token.email_verified && 
             request.auth.token.email.lower() == invData.targetEmail.lower();
    }

    // --- ACCESS GRANTS (MANAGEMENT) ---
    match /business_invitations/{invId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.ownerUid || isInvitationRecipient(resource.data));
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerUid;
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.ownerUid) || 
        (isInvitationRecipient(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'targetUid']))
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerUid;
    }

    match /business_access_grants/{grantId} {
      allow read: if isSignedIn() && (request.auth.uid in grantId.split('_'));
      allow create: if isSignedIn() && 
                     request.auth.uid == request.resource.data.targetUid &&
                     grantId == request.resource.data.ownerUid + "_" + request.auth.uid;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerUid;
    }

    // --- INFRASTRUCTURE ---
    match /audit_logs/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin';
    }

    match /supportTickets/{ticketId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || (exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin'));
      allow update, delete: if isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin';
    }

    // --- USERS BRANCH ---
    match /users/{userId} {
      // Inlined Admin Access
      allow read: if isOwner(userId) || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin');
      allow create, delete: if isOwner(userId) || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin');

      match /profile/{allPaths=**} {
        allow read: if isOwner(userId) || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin');
        allow create, delete: if isOwner(userId) || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin');
        allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan', 'uid', 'emailVerified', 'ownerUid', 'createdAt'])) || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin');
      }

      match /aiUsage/{docId} {
        allow read: if isOwner(userId) || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin');
        allow write: if isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin';
      }

      match /linkedAccounts/{docId} {
        allow read, write: if isOwner(userId) || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin');
      }

      match /{collectionName}/{docId} {
        allow read: if isOwner(userId) || 
                    (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin') || 
                    (isBusinessCollection(collectionName) && 
                     exists(/databases/$(database)/documents/business_access_grants/$(userId + "_" + request.auth.uid)) && 
                     get(/databases/$(database)/documents/business_access_grants/$(userId + "_" + request.auth.uid)).data.context == 'business' &&
                     resource.data.context == 'business');
        
        allow create: if (isOwner(userId) || 
                        (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin') || 
                        (isBusinessCollection(collectionName) && 
                         exists(/databases/$(database)/documents/business_access_grants/$(userId + "_" + request.auth.uid)) && 
                         get(/databases/$(database)/documents/business_access_grants/$(userId + "_" + request.auth.uid)).data.accessLevel == 'editor' &&
                         request.resource.data.context == 'business' &&
                         (!('creatorId' in request.resource.data) || request.resource.data.creatorId == request.auth.uid)
                        )) && isValidTransaction(request.resource.data);

        allow update: if (isOwner(userId) || 
                        (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin') || 
                        (isBusinessCollection(collectionName) && 
                         exists(/databases/$(database)/documents/business_access_grants/$(userId + "_" + request.auth.uid)) && 
                         get(/databases/$(database)/documents/business_access_grants/$(userId + "_" + request.auth.uid)).data.accessLevel == 'editor' &&
                         request.resource.data.context == 'business' &&
                         resource.data.context == 'business'
                        )) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan', 'uid', 'emailVerified', 'ownerUid', 'createdAt'])) && isValidTransaction(request.resource.data);

        allow delete: if isOwner(userId) || 
                      (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin') || 
                      (isBusinessCollection(collectionName) && 
                       exists(/databases/$(database)/documents/business_access_grants/$(userId + "_" + request.auth.uid)) && 
                       get(/databases/$(database)/documents/business_access_grants/$(userId + "_" + request.auth.uid)).data.accessLevel == 'editor' &&
                       resource.data.context == 'business');
      }

      match /{allPaths=**} {
        allow read, write: if isOwner(userId) || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin');
      }
    }
  }
}
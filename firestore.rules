rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions (Standard CEL - Pure Expressions)
    // ------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId || 
        (exists(/databases/$(database)/documents/users/$(userId)/profile/$(userId)) && 
         get(/databases/$(database)/documents/users/$(userId)/profile/$(userId)).data.ownerUid == request.auth.uid)
      );
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.role == 'admin';
    }

    function isContextMixed(col) {
      return col in ['expenses', 'incomeSources', 'bills'];
    }

    function isBusinessOnly(col) {
      return col in ['customers', 'invoices', 'receipts', 'budgets', 'savingsGoals', 'shoppingLists', 'vendors', 'savingsChallenges', 'milestones', 'checkins'];
    }

    function hasBusinessAccess(ownerId) {
      return isSignedIn() && exists(/databases/$(database)/documents/business_access_grants/$(ownerId + "_" + request.auth.uid));
    }

    function getBusinessAccessLevel(ownerId) {
      return get(/databases/$(database)/documents/business_access_grants/$(ownerId + "_" + request.auth.uid)).data.accessLevel;
    }

    function isValidFinancialEntry(data) {
      return data.amount is number && 
             data.amount >= 0 &&
             data.category is string &&
             data.date is timestamp &&
             data.description is string;
    }

    function isValidBusinessDoc(data) {
      // Business documents (customers, invoices, etc.) should not be blocked by 
      // missing 'amount' or 'category' fields required for financial transactions.
      return (data.name is string || data.description is string || data.customerId is string);
    }

    function isInvitationRecipient(data) {
      return isEmailVerified() && request.auth.token.email.lower() == data.targetEmail.lower();
    }

    // --- ACCESS GRANTS (MANAGEMENT) ---
    match /business_invitations/{invId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.ownerUid || 
        request.auth.token.email.lower() == resource.data.targetEmail.lower()
      );
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerUid;
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.ownerUid) || 
        (isInvitationRecipient(resource.data) && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'targetUid']) &&
         resource.data.status == 'pending' &&
         request.resource.data.status in ['accepted', 'rejected'])
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerUid;
    }

    match /business_access_grants/{grantId} {
      allow read: if isEmailVerified() && (
        request.auth.uid in grantId.split('_') ||
        request.auth.token.email.lower() == resource.data.targetEmail.lower()
      );
      allow create: if isSignedIn() && (
        // SECURITY PATCH: Self-creation of a grant is ONLY allowed if a valid, 
        // accepted invitation exists for this owner and target email.
        (request.auth.uid == request.resource.data.targetUid && 
         isEmailVerified() &&
         grantId == request.resource.data.ownerUid + "_" + request.auth.uid &&
         exists(/databases/$(database)/documents/business_invitations/$(request.resource.data.ownerUid + "_" + request.auth.token.email.lower())) &&
         get(/databases/$(database)/documents/business_invitations/$(request.resource.data.ownerUid + "_" + request.auth.token.email.lower())).data.status == 'accepted'
        ) ||
        (isEmailVerified() && request.auth.uid == request.resource.data.ownerUid && grantId == request.auth.uid + "_" + request.resource.data.targetUid) ||
        (isOwner(request.resource.data.ownerUid))
      );
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.ownerUid || request.auth.uid == resource.data.targetUid);
    }

    // --- INFRASTRUCTURE ---
    match /audit_logs/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if isAdmin();
    }

    // --- USERS BRANCH ---
    match /users/{userId} {
      allow read, create, delete: if isOwner(userId) || isAdmin();

      match /profile/{allPaths=**} {
        allow read: if isOwner(userId) || isAdmin() || hasBusinessAccess(userId);
        allow delete: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin() || (
          isSignedIn() && 
          userId.matches('^vbus_.*') && 
          request.resource.data.ownerUid == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid)).data.plan in ['pro-plus', 'Pro Plus', 'pro_plus']
        );
        allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan', 'uid', 'emailVerified', 'ownerUid', 'createdAt'])) || isAdmin();
      }

      match /aiUsage/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      match /linkedAccounts/{docId} {
        // Only the account owner can read, link, unlink, or change account purpose.
        // Delegates must NEVER be able to alter accountPurpose — this would let them
        // re-route synced transactions between personal and business data.
        allow read: if isOwner(userId) || isAdmin();
        allow create, delete: if isOwner(userId) || isAdmin();
        allow update: if (isOwner(userId) || isAdmin()) &&
          // Prevent even the owner from accidentally updating dangerous fields.
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId']);
      }

      match /notifications/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /{collectionName}/{docId} {
        allow read: if isOwner(userId) || 
                    isAdmin() || 
                    (isContextMixed(collectionName) && 
                     hasBusinessAccess(userId) && 
                     resource.data.context == 'business') ||
                    (isBusinessOnly(collectionName) && 
                     hasBusinessAccess(userId));
        
        allow create: if (isOwner(userId) || 
                        isAdmin() || 
                        (isContextMixed(collectionName) && 
                         hasBusinessAccess(userId) &&
                         getBusinessAccessLevel(userId) == 'editor' &&
                         request.resource.data.context == 'business' &&
                         (!('creatorId' in request.resource.data) || request.resource.data.creatorId == request.auth.uid)
                        ) ||
                        (isBusinessOnly(collectionName) && 
                         hasBusinessAccess(userId) &&
                         getBusinessAccessLevel(userId) == 'editor' &&
                         (!('creatorId' in request.resource.data) || request.resource.data.creatorId == request.auth.uid)
                        )) && (isContextMixed(collectionName) ? isValidFinancialEntry(request.resource.data) : isValidBusinessDoc(request.resource.data));

        allow update: if (isOwner(userId) || 
                        isAdmin() || 
                        (isContextMixed(collectionName) && 
                         hasBusinessAccess(userId) &&
                         getBusinessAccessLevel(userId) == 'editor' &&
                         request.resource.data.context == 'business' &&
                         resource.data.context == 'business'
                        ) ||
                        (isBusinessOnly(collectionName) && 
                         hasBusinessAccess(userId) &&
                         getBusinessAccessLevel(userId) == 'editor'
                        )) && 
                        // SECURITY: Only the account owner can reclassify transactions
                        // (toggle context or clear needsReview). Delegates can only edit
                        // business-scoped fields and must never touch reconciliation fields.
                        (hasBusinessAccess(userId) ? 
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['context', 'needsReview', 'sourceAccountId']) : true) &&
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan', 'uid', 'emailVerified', 'ownerUid', 'createdAt'])) && 
                        (isContextMixed(collectionName) ? isValidFinancialEntry(request.resource.data) : isValidBusinessDoc(request.resource.data));

        allow delete: if isOwner(userId) || 
                      isAdmin() || 
                      (isContextMixed(collectionName) && 
                       hasBusinessAccess(userId) &&
                       getBusinessAccessLevel(userId) == 'editor' &&
                       resource.data.context == 'business'
                      ) ||
                      (isBusinessOnly(collectionName) && 
                       hasBusinessAccess(userId) &&
                       getBusinessAccessLevel(userId) == 'editor');
      }

      match /mfa_verifications/{allPaths=**} {
        // Verification docs must NEVER be accessible from the client.
        // All generation and verification happens via secure API routes.
        allow read, write: if false;
      }

      match /{allPaths=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
  }
}
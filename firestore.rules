rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      let adminPath = /databases/$(database)/documents/users/$(request.auth.uid)/profile/$(request.auth.uid);
      return isSignedIn() && exists(adminPath) && get(adminPath).data.role == 'admin';
    }

    function isSafeUpdate() {
      let data = request.resource.data;
      let existing = resource.data;
      return data.role == existing.role && data.plan == existing.plan;
    }

    // ------------------------------------------------------------------------
    // Nested User-Centric Rules
    // ------------------------------------------------------------------------

    // Users Branch
    match /users/{userId} {
      // Allow the owner full recursive access to their own data tree
      // This is the most robust way to ensure no path-mismatch errors
      allow read, write: if isOwner(userId) || isAdmin();

      // Recursive catch-all for all subcollections (profile, expenses, etc.)
      match /{allPaths=**} {
        allow read: if isOwner(userId) || isAdmin();
        
        // Owners can write anything to their own sub-paths
        // Admins can also write
        allow write: if isOwner(userId) || isAdmin();
        
        // Specific protection for Plan and Role if the profile exists
        // (Ensures users can't upgrade themselves for free)
        allow update: if (isOwner(userId) && isSafeUpdate()) || isAdmin();
      }
    }

    // Global Collections (If ANY)
    // Add non-user-specific collections here
  }
}
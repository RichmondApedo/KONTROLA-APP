/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model. All user-related data,
 * including profiles, income, and expenses, is stored in subcollections under a path
 * unique to that user's ID (`/users/{userId}`). This ensures that a user can only ever
 * access their own data.
 *
 * Data Structure: The entire data model is hierarchical, starting with the `/users` collection.
 * Each user document at `/users/{userId}` acts as a container for their private data, which
 * includes a singular `profile` document and subcollections for `incomeSources`, `expenses`,
 * `financialAdvices`, `budgets`, and `savingsGoals`.
 *
 * Key Security Decisions:
 * - User data is completely segregated. There are no shared or public resources.
 * - Listing of the top-level `/users` collection is explicitly disallowed to prevent user enumeration.
 * - A user must be authenticated to perform any action.
 * - Authorization is primarily based on matching the requesting user's UID with the `userId` in the
 *   document path.
 *
 * Denormalization for Authorization: The data structure is designed for efficient security rules.
 * Each document within a user's data tree (e.g., an Expense or IncomeSource) contains a `userId`
 * field. The rules enforce that this internal `userId` always matches the `userId` in the path,
 * ensuring data integrity and preventing documents from being associated with the wrong user.
 * This avoids the need for any cross-document `get()` calls for authorization checks.
 *
 * Structural Segregation: The use of a top-level `/users/{userId}` path for all user data is a
 * perfect example of structural segregation. It creates a secure boundary around each user's
 * data, making it impossible for one user's queries to accidentally leak data from another.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    /**
     * isSignedIn
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * isOwner
     * Checks if the authenticated user's UID matches the provided userId.
     * This is the foundation of the user-ownership security model.
     * @param userId The user ID to check against the request's auth UID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * isExistingOwner
     * A robust check for update and delete operations. Ensures the document
     * exists AND the user is the rightful owner before allowing the operation.
     * @param userId The user ID to check against the request's auth UID.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * isCreatingOwnProfile
     * Validates that a user is creating their own profile document and that the
     * profile data correctly includes their own user ID for relational integrity.
     * @param userId The user ID from the path.
     */
    function isCreatingOwnProfile(userId, docId) {
      return isOwner(userId) && request.resource.data.id == userId && userId == docId;
    }

    /**
     * isUpdatingOwnProfile
     * Validates that a user is updating their own existing profile and prevents
     * the critical `id` field from being changed.
     * @param userId The user ID from the path.
     */
    function isUpdatingOwnProfile(userId, docId) {
      return isExistingOwner(userId) && request.resource.data.id == resource.data.id && userId == docId;
    }

    /**
     * isCreatingOwnSubcollectionDoc
     * Validates that a user is creating a document (e.g., expense, income) in their
     * own subcollection and that the data correctly references their own user ID.
     * @param userId The user ID from the path.
     */
    function isCreatingOwnSubcollectionDoc(userId) {
      return isOwner(userId) && request.resource.data.userId == userId;
    }

    /**
     * isUpdatingOwnSubcollectionDoc
     * Validates that a user is updating their own existing subcollection document
     * and prevents the critical `userId` foreign key from being changed.
     * @param userId The user ID from the path.
     */
    function isUpdatingOwnSubcollectionDoc(userId) {
      return isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
    }

    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------

    /**
     * @description Rules for the user data container. This path itself does not
     *              represent a readable document but serves as the root for all
     *              of a single user's private data.
     * @path        /users/{userId}
     * @allow       (none) - Direct access is denied. Listing users is forbidden.
     * @deny        A non-authenticated or different user trying to list or get user documents.
     * @principle   Restricts access to a user's own data tree and prevents user enumeration.
     */
    match /users/{userId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      /**
       * @description A user's own profile document. The document ID must match the user's ID.
       *              Only the owner of the user tree can manage this document.
       * @path        /users/{userId}/profile/{docId}
       * @allow       (create) An authenticated user creating their own profile document, where the docId is their userId.
       *              e.g., `db.collection('users/user_abc/profile').doc('user_abc').set({ id: 'user_abc', ... })`
       * @deny        (update) User 'user_xyz' trying to update the profile for 'user_abc'.
       * @principle   Enforces document ownership and relational integrity via the `id` field and matching docId.
       */
      match /profile/{docId} {
        allow get: if isOwner(userId) && docId == userId;
        allow list: if isOwner(userId);
        allow create: if isCreatingOwnProfile(userId, docId);
        allow update: if isUpdatingOwnProfile(userId, docId);
        allow delete: if isExistingOwner(userId) && docId == userId;
      }

      /**
       * @description A user's private income sources. Only the user can read or write their own sources.
       * @path        /users/{userId}/incomeSources/{incomeSourceId}
       * @allow       (list) User 'user_abc' listing their own income sources.
       *              e.g., `db.collection('users/user_abc/incomeSources').get()`
       * @deny        (create) User 'user_abc' creating an income source with `userId: 'user_xyz'`.
       * @principle   Restricts access to a user's own data tree and validates relational integrity.
       */
      match /incomeSources/{incomeSourceId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isCreatingOwnSubcollectionDoc(userId);
        allow update: if isUpdatingOwnSubcollectionDoc(userId);
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description A user's private expenses. Only the user can read or write their own expenses.
       * @path        /users/{userId}/expenses/{expenseId}
       * @allow       (get) User 'user_abc' reading a single expense document.
       *              e.g., `db.doc('users/user_abc/expenses/exp_123').get()`
       * @deny        (delete) User 'user_xyz' trying to delete an expense belonging to 'user_abc'.
       * @principle   Restricts access to a user's own data tree and validates relational integrity.
       */
      match /expenses/{expenseId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isCreatingOwnSubcollectionDoc(userId);
        allow update: if isUpdatingOwnSubcollectionDoc(userId);
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description A user's private financial advice. Only the user can read or write their advice.
       * @path        /users/{userId}/financialAdvices/{financialAdviceId}
       * @allow       (create) User 'user_abc' creating a new financial advice document.
       *              e.g., `db.collection('users/user_abc/financialAdvices').add({ userId: 'user_abc', ... })`
       * @deny        (update) An unauthenticated user trying to update any financial advice.
       * @principle   Restricts access to a user's own data tree and validates relational integrity.
       */
      match /financialAdvices/{financialAdviceId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isCreatingOwnSubcollectionDoc(userId);
        allow update: if isUpdatingOwnSubcollectionDoc(userId);
        allow delete: if isExistingOwner(userId);
      }
      
      /**
       * @description A user's private budgets. Only the user can manage their own budgets.
       * @path        /users/{userId}/budgets/{budgetId}
       * @allow       (list) User 'user_abc' listing their own budgets.
       * @deny        (create) User 'user_abc' creating a budget with `userId: 'user_xyz'`.
       * @principle   Restricts access to a user's own data tree and validates relational integrity.
       */
      match /budgets/{budgetId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isCreatingOwnSubcollectionDoc(userId);
        allow update: if isUpdatingOwnSubcollectionDoc(userId);
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description A user's savings goal.
       * @path        /users/{userId}/savingsGoals/{savingsGoalId}
       * @allow       (list, get, create, update) A user managing their own savings goal.
       * @deny        (create) User 'user_abc' creating a goal with `userId: 'user_xyz'`.
       * @principle   Restricts access to a user's own data tree and validates relational integrity.
       */
      match /savingsGoals/{savingsGoalId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isCreatingOwnSubcollectionDoc(userId);
        allow update: if isUpdatingOwnSubcollectionDoc(userId);
        allow delete: if isExistingOwner(userId);
      }

       /**
       * @description A user's bills.
       * @path        /users/{userId}/bills/{billId}
       * @allow       (list, get, create, update) A user managing their own bills.
       * @deny        (create) User 'user_abc' creating a bill with `userId: 'user_xyz'`.
       * @principle   Restricts access to a user's own data tree and validates relational integrity.
       */
      match /bills/{billId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isCreatingOwnSubcollectionDoc(userId);
        allow update: if isUpdatingOwnSubcollectionDoc(userId);
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description A user's linked financial accounts.
       * @path        /users/{userId}/linkedAccounts/{linkedAccountId}
       * @allow       A user managing their own linked accounts.
       * @deny        Another user trying to access or manage linked accounts.
       * @principle   Restricts access to a user's own data tree.
       */
      match /linkedAccounts/{linkedAccountId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isCreatingOwnSubcollectionDoc(userId);
        allow update: if isUpdatingOwnSubcollectionDoc(userId);
        allow delete: if isExistingOwner(userId);
      }
      
      /**
       * @description A user's business customers. Only the user can manage their own customers.
       * @path        /users/{userId}/customers/{customerId}
       * @allow       (list, get, create, update, delete) A user managing their own customers.
       * @deny        (create) User 'user_abc' creating a customer with `userId: 'user_xyz'`.
       * @principle   Restricts access to a user's own data tree and validates relational integrity.
       */
      match /customers/{customerId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isCreatingOwnSubcollectionDoc(userId);
        allow update: if isUpdatingOwnSubcollectionDoc(userId);
        allow delete: if isExistingOwner(userId);
      }
      
      /**
       * @description A user's business invoices. Only the user can manage their own invoices.
       * @path        /users/{userId}/invoices/{invoiceId}
       * @allow       (list, get, create, update, delete) A user managing their own invoices.
       * @deny        (create) User 'user_abc' creating an invoice with `userId: 'user_xyz'`.
       * @principle   Restricts access to a user's own data tree and validates relational integrity.
       */
      match /invoices/{invoiceId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isCreatingOwnSubcollectionDoc(userId);
        allow update: if isUpdatingOwnSubcollectionDoc(userId);
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description A user's business payment receipts. Only the user can manage their own receipts.
       * @path        /users/{userId}/receipts/{receiptId}
       * @allow       (list, get, create, update, delete) A user managing their own receipts.
       * @deny        (create) User 'user_abc' creating a receipt with `userId: 'user_xyz'`.
       * @principle   Restricts access to a user's own data tree and validates relational integrity.
       */
      match /receipts/{receiptId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isCreatingOwnSubcollectionDoc(userId);
        allow update: if isUpdatingOwnSubcollectionDoc(userId);
        allow delete: if isExistingOwner(userId);
      }
    }

    /**
     * @description Public home page banners. These are read-only for all clients.
     * @path        /home_banners/{bannerId}
     * @allow       (get, list) Anyone can read the banners.
     * @deny        (write) All client-side writes are forbidden. Banners should be managed via a secure admin backend.
     * @principle   Provides public read access to non-sensitive content.
     */
    match /home_banners/{bannerId} {
        allow get, list: if true;
        allow create, update, delete: if false;
    }
  }
}

    
